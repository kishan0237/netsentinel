# ============================================================================
# NetSentinel environment variables
# Copy relevant sections into: Render (backend), Vercel (frontend), local shell
# ============================================================================

# --- Backend (Render -> app/backend) ----------------------------------------
# Supabase Postgres connection string.
# Supabase Dashboard -> Connect -> Direct (Connection string):
#   - Session pooler (port 5432)  <- recommended: IPv4-compatible, works everywhere
#   - Transaction pooler (port 6543) is for serverless only - not for Render
# Replace YOUR-PASSWORD with your real DB password. Example:
DATABASE_URL=postgresql://postgres.abcdefgh:YOUR-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Comma-separated list of allowed dashboard origins (Vercel domain + local dev)
CORS_ORIGINS=https://netsentinel.vercel.app,http://localhost:5173,http://localhost:4173

# Optional: guards DELETE /api/agents/{uuid}. Render can generate this for you.
ADMIN_API_KEY=change-me

# Optional: NVD API key for live CVE enrichment (https://nvd.nist.gov/developers/request-an-api-key)
NVD_API_KEY=

# Create tables on startup if missing (idempotent; migration SQL also provided)
AUTO_CREATE_TABLES=true

# Rate limits (requests per minute). Raise for testing.
RATE_LIMIT_GENERAL=120
RATE_LIMIT_SCAN_CREATE=10
RATE_LIMIT_REGISTER=20
RATE_LIMIT_HEARTBEAT=240

# --- Frontend (Vercel -> project root, Vite) ---------------------------------
# The Render API base URL. Vercel env vars must be prefixed VITE_ to be inlined.
VITE_API_URL=https://netsentinel-api.onrender.com

# --- Agent (user's machine) ---------------------------------------------------
NETSENTINEL_API_URL=https://netsentinel-api.onrender.com
AGENT_POLL_INTERVAL=3
